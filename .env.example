# Copiar a .env para desarrollo local. NUNCA commitear .env (repo público).
#
# En AWS, estos valores NO viven como variables de entorno en texto plano:
# - Los no sensibles (TABLE_NAME, BUCKET_NAME) los inyecta CDK como env var del Lambda.
# - Los sensibles (tokens/API keys) se leen en runtime desde SSM Parameter Store
#   (SecureString, cifrado con la KMS key default de AWS — sin costo). Ver
#   src/shared/config/env.ts y CLAUDE.md → "Manejo de secretos".

AWS_REGION=us-east-1
TABLE_NAME=calorie-companion-dev
BUCKET_NAME=calorie-companion-dev-media

# Solo para desarrollo local (nunca en Lambda real):
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
