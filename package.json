{
  "name": "calorie-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Telegram para trackear comidas de bulk-cooking. Costo objetivo: $0.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p infra/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cdk:synth": "cd infra && cdk synth",
    "cdk:diff": "cd infra && cdk diff",
    "cdk:deploy": "cd infra && cdk deploy --all"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1120.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-ssm": "^3.1120.0",
    "@aws-sdk/lib-dynamodb": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "electrodb": "^3.9.3",
    "openai": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "aws-cdk": "^2.1139.0",
    "eslint": "^10.9.1",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
